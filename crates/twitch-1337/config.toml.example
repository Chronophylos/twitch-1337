# Twitch 1337 Bot Configuration
# Copy this file to config.toml and fill in your credentials

[twitch]
# Twitch channel to monitor (without the # prefix)
channel = "your_channel"

# Bot's Twitch username
username = "your_bot_username"

# OAuth refresh token (used to get new access tokens automatically)
refresh_token = "your_refresh_token_here"

# Twitch application client ID
client_id = "your_client_id"

# Twitch application client secret
client_secret = "your_client_secret"

# Twitch user ID with full dashboard access including the settings page.
# Absent → no owner exists and the settings page returns 403.
# owner = "12345678"

# Permissions (hidden_admins, viewer_allowlist), the admin channel
# (admin_channel), and expected_latency now live in the
# dashboard (`/settings → Twitch · Permissions` and `Twitch · Channels`).

# Optional: distinct Twitch accounts for the AI agents' outbound chat (Helix
# speak-only; they do NOT join IRC). Omit a section to fall back to the utility
# bot's IRC voice for that agent. Each mouth needs a user access token authorized
# against the SAME Twitch app (shared client_id/client_secret) with scope
# `user:write:chat` ONLY. Refreshed tokens are persisted per mouth to
# $DATA_DIR/token-aurora.ron and $DATA_DIR/token-grok.ron. Adding or removing a
# mouth takes effect on the next bot restart.
# [twitch.mouths.aurora]
# username = "aurora_bot"
# refresh_token = "..."
# [twitch.mouths.grok]
# username = "grok_bot"
# refresh_token = "..."

# Optional: Aviationstack metadata enrichment for !track.
# The api_key is a secret and stays in config.toml. Enable + base_url +
# timeout_secs are managed in the dashboard (`/settings → Aviationstack`).
# [aviationstack]
# api_key = "your_aviationstack_api_key_here"

# Optional: DHL Shipment Tracking - Unified API, backing Aurora's
# track_shipment tool. The api_key is a secret and is the entire config
# surface — its presence enables the tool, its absence hides the tool
# from the model completely. There is no dashboard toggle.
# Get a key at https://developer.dhl.com (free tier: 250 calls/day).
# [dhl]
# api_key = "your_dhl_api_key_here"

# Optional: ipinfo.io enrichment for Aurora's lookup_network tool. The tool
# itself runs on keyless RDAP and is always available; with a token, IP
# lookups also return city/region/country, ASN/org and hostname. The token
# is a secret and the entire config surface. There is no dashboard toggle.
# Adding or removing the section needs a restart.
# Get a token at https://ipinfo.io/signup.
# [ipinfo]
# token = "your_ipinfo_token_here"

# Optional: CubeCoders AMP game-server panel. Presence enables `!servers`
# (list online servers, `!servers <name>` for details). Create a dedicated
# AMP user whose role allows only `Instances.*`. url needs http:// or
# https://. Per-user cooldown lives at /settings → Cooldowns. Restart to apply.
# [amp]
# url = "http://192.0.2.1:8080"
# username = "twitch-1337"
# password = "..."

# Optional: Finnhub stock quotes (free tier is enough). Presence enables the
# joke `!aktien` / `!stocks` command (today's two best and worst performer of
# a baked ticker pool). Per-user cooldown lives at /settings → Cooldowns.
# Get a key at https://finnhub.io/register. Restart to apply.
# [finnhub]
# api_key = "your_finnhub_api_key_here"

# Optional: first-party LLM traces (every Turn, its LLM calls and tools) to
# Langfuse Cloud over OTLP. Presence enables export, with or without [otel];
# init/export failures never abort the bot. No dashboard card — keys stay
# here. Default host is the EU cloud.
# [langfuse]
# public_key = "pk-lf-..."
# secret_key = "sk-lf-..."
# # host = "https://cloud.langfuse.com"  # EU default; US = https://us.cloud.langfuse.com

# Optional: export logs, traces and metrics over OTLP/HTTP (protobuf) to a
# collector such as Grafana Alloy. Presence enables export; absent, nothing
# leaves the process. `endpoint` is the collector's base URL (http:// on the
# LAN; `/v1/traces`, `/v1/logs`, `/v1/metrics` are appended), no credentials
# in it. `auth_header`, if set, is sent verbatim as `Authorization`.
# Init or export failures log a warning and drop signals; the bot keeps
# running and stdout is the record. What gets exported is filtered at
# /settings → Observability (live). Restart to add or remove this section.
# [otel]
# endpoint = "http://alloy:4318"
# # auth_header = "Basic dXNlcjpwYXNz"

# Suspend defaults now live in the dashboard (`/settings → Suspend`).

# Optional: AI configuration for the !ai command
# If absent, the !ai command is disabled.
#
# Only credentials are read from this file: an [ai.keys] table of named keys.
# A profile stores a key *name*, never the secret, so switching providers
# from the dashboard never touches this file. A leftover [ai].api_key is
# ignored — move it into [ai.keys] and set the profile's key name.
#
# Provider, base URL, model, timeout, reasoning effort and service tier live
# in named profiles, managed at /ai-profiles (owner only — a profile carries
# base_url/key, so it's gated the same as /settings). Memory caps, dreamer
# schedule, and web/emote/media tool toggles live in the dashboard at
# /settings (owner only). Both persist to $DATA_DIR/settings.ron. A leftover
# [ai].* table from earlier versions is ignored — runtime AI knobs are
# dashboard-managed only.
#
# [ai.keys]
# openrouter = "sk-or-..."
# openai = "sk-..."
# groq = "gsk_..."

# Schedules live in the dashboard at /schedules; settings.ron stores the
# canonical list. A leftover [[schedules]] in this file is ignored.

# [web]                            # uncomment to enable the dashboard
# enabled = true
# bind_addr = "0.0.0.0:8080"
# public_url = "https://bot.example.com"
# session_secret = "<32+ bytes of hex>"
# # session_ttl and mod_check_refresh are now managed in the dashboard
# # (`/settings → Web · Sessions`).
